#!/bin/bash

pprint (){
    cred='\033[0;31m'
    cgreen='\033[0;32m'
    cyellow='\033[0;33m'
    cblue='\033[0;34m'
    cmagenta='\033[0;35m'
    ccyan='\033[0;36m'
    creset='\033[0m'

    if [ -z "$2" ]; then
        color="$cmagenta"
    else
        eval "color=\$$2"
    fi
    printf "$color$1$creset"
}

yesnoprompt(){
    old_stty_cfg=$(stty -g)
    stty raw -echo; answer=$(head -c 1)
    stty $old_stty_cfg
    echo "$answer" | grep -iq "^y"
}

check_python_version(){
    if ! command -v python3 &>/dev/null; then
        pprint "\nPython3 is not installed.\n" "cred"
        exit 1
    fi

    version=$(python3 -c 'import sys; print("{}.{}".format(sys.version_info[0], sys.version_info[1]))')
    required="3.7"
    if [[ $(echo -e "$version\n$required" | sort -V | head -n1) != "$required" ]]; then
        pprint "\nPython 3.7 or higher is required. Detected: $version\n" "cred"
        exit 1
    else
        pprint "\nPython version $version is compatible.\n" "cgreen"
    fi
}

update() {
    pprint "\n\nChecking for package updates... " "ccyan"
    sudo apt update 2>&1 | grep "can be upgraded" &>/dev/null
    if [ $? -eq 0 ]; then
        pprint "UPDATES AVAILABLE\n" "cyellow"
        pprint "Do you want to upgrade packages automatically? (y/n): " "ccyan"
        if yesnoprompt; then
            pprint "\nUpgrading packages... " "ccyan"
            sudo apt upgrade -y &>/dev/null &&
            pprint "DONE\n" "cgreen" || (pprint "FAILED\n" "cred"; exit 1)
        else
            echo
        fi
    else
        pprint "ALREADY UP TO DATE\n" "cgreen"
    fi
}

packages(){
    pprint "\nChecking required packages...\n" "ccyan"

    if ! command -v pip3 &>/dev/null; then
        pprint "Installing pip... " "ccyan"
        sudo apt install python3-pip -y 2>pypilog.txt 1>/dev/null &&
        pprint "SUCCESS\n" "cgreen" || (pprint "FAIL\n" "cred"; exit 1)
    fi

    if ! command -v ffmpeg &>/dev/null; then
        pprint "Installing ffmpeg... " "ccyan"
        sudo apt install ffmpeg -y &>/dev/null &&
        pprint "SUCCESS\n" "cgreen" || (pprint "FAIL. Install ffmpeg manually.\n" "cred"; exit 1)
    fi

    if ! python3 -m venv --help &>/dev/null; then
        pprint "Installing python3-venv... " "ccyan"
        sudo apt install python3-venv -y &>/dev/null &&
        pprint "SUCCESS\n" "cgreen" || (pprint "FAIL\n" "cred"; exit 1)
    fi

    sudo apt install -y git curl &>/dev/null
}

install_requirements(){
    pprint "\nSetting up Python virtual environment...\n" "ccyan"
    if [ ! -d "venv" ]; then
        python3 -m venv venv && pprint "Virtual environment created.\n" "cgreen"
    else
        pprint "Existing virtual environment found.\n" "cyellow"
    fi
    source venv/bin/activate

    pprint "\nInstalling Python dependencies...\n" "ccyan"
    pip install --upgrade pip &>>pypilog.txt
    pip install -r requirements.txt &>>pypilog.txt &&
    pprint "Dependencies installed.\n" "cgreen" || (pprint "FAILED\n" "cred"; exit 1)
}

display_banner(){
    cmagenta='\033[0;35m'
    creset='\033[0m'
    printf "$cmagenta"
    cat << "EOF"

     █████╗ ██╗   ██╗ █████╗     ██████╗  ██████╗ ██████╗  ██████╗ ████████╗
    ██╔══██╗██║   ██║██╔══██╗    ██╔══██╗██╔═══██╗██╔══██╗██╔═══██╗╚══██╔══╝
    ███████║██║   ██║███████║    ██████╔╝██║   ██║██████╔╝██║   ██║   ██║   
    ██╔══██║╚██╗ ██╔╝██╔══██║    ██╔══██╗██║   ██║██╔══██╗██║   ██║   ██║   
    ██║  ██║ ╚████╔╝ ██║  ██║    ██║  ██║╚██████╔╝██████╔╝╚██████╔╝   ██║   
    ╚═╝  ╚═╝  ╚═══╝  ╚═╝  ╚═╝    ╚═╝  ╚═╝ ╚═════╝ ╚═════╝  ╚═════╝    ╚═╝   

EOF
    printf "$creset"
}

collect_env(){
    clear
    display_banner
    pprint "\nEnter the required values below:\n\n" "cgreen"

    pprint "API ID: " "cyellow"; read api_id
    pprint "API HASH: " "cyellow"; read api_hash
    pprint "BOT TOKEN: " "cyellow"; read token

    while true; do
        pprint "OWNER ID (digits only): " "cyellow"; read owner_id
        if [[ "$owner_id" =~ ^[0-9]+$ ]]; then break; else
            pprint "Invalid input. Must be numeric.\n" "cred"
        fi
    done

    pprint "OWNER USERNAME (optional): " "cyellow"; read owner_user
    pprint "SUPPORT CHAT (optional): " "cyellow"; read support_chat
    pprint "LOGGER GROUP ID: " "cyellow"; read logger_id
    pprint "MONGO DB URI: " "cyellow"; read mongo_uri
    pprint "DB NAME (optional): " "cyellow"; read db_name
    pprint "DATABASE URL: " "cyellow"; read db_url
    pprint "DEEP AI API KEY (optional): " "cyellow"; read deep_api
    pprint "ARQ API KEY: " "cyellow"; read arq_key
    pprint "SPAMWATCH API: " "cyellow"; read spamwatch_api

    pprint "\nCreating .env file...\n" "ccyan"

    if [ -f .env ]; then rm .env; fi

    cat << EOF > .env
API_ID=$api_id
API_HASH=$api_hash
TOKEN=$token
OWNER_ID=$owner_id
OWNER_USERNAME=$owner_user
SUPPORT_CHAT=$support_chat
LOGGER_ID=$logger_id
MONGO_DB_URI=$mongo_uri
DB_NAME=$db_name
DATABASE_URL=$db_url
DEEP_API=$deep_api
ARQ_API_KEY=$arq_key
SPAMWATCH_API=$spamwatch_api
EOF

    clear
    pprint "\n✅ .env file created successfully!\n" "cgreen"
    pprint "Edit it any time using: nano .env\n" "ccyan"
    pprint "\nYou can now start AvaRobot with:\n" "cgreen"
    pprint "   bash start\n\n" "cyellow"
}

# ========== Start Script ==========
clear
display_banner
pprint "\nWelcome to AvaRobot Setup\n\n" "cgreen"
pprint "This script needs sudo privileges to install packages.\n" "ccyan"
sudo test

check_python_version
update
packages
install_requirements
collect_env
