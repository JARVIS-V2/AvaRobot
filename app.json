{
  "name": "AvaRobot",
  "description": "Telegram Group Management Bot built with python-telegram-bot and Pyrogram.",
  "repository": "https://github.com/CertifiedCoders/AvaRobot",
  "logo": "https://telegra.ph/file/61296490da95c55a1d5ee.jpg",
  "keywords": ["python", "telegram", "bot", "AvaRobot", "management", "telethon", "pyrogram"],
  "stack": "heroku-24",
  "buildpacks": [
    { "url": "heroku/python" },
    { "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest" }
  ],
  "addons": [
    {
      "plan": "heroku-postgresql",
      "options": {
        "version": "14"
      }
    }
  ],
  "env": {
    "API_ID": {
      "description": "Get this from https://my.telegram.org/apps",
      "required": true,
      "value": ""
    },
    "API_HASH": {
      "description": "Get this from https://my.telegram.org/apps",
     "required": true,
      "value": ""
    },
    "TOKEN": {
      "description": "Get bot token from @BotFather",
      "required": true,
      "value": ""
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID",
      "required": true,
      "value": "7044783841"
    },
    "OWNER_USERNAME": {
      "description": "Your Telegram username",
      "required": true,
      "value": "CertifiedCoder"
    },
    "LOGGER_ID": {
      "description": "Channel or group ID to receive log messages",
      "required": true,
      "value": ""
    },
    "SUPPORT_CHAT": {
      "description": "Public support group username (no @)",
      "required": false,
      "value": "CertifiedCoders"
    },
    "MONGO_DB_URI": {
      "description": "MongoDB connection string",
      "required": true,
      "value": ""
    },
    "DEEP_API": {
      "description": "API key from https://deepai.org/",
      "required": false,
      "value": ""
    },
    "ARQ_API_KEY": {
      "description": "Get from https://t.me/ARQRobot",
      "required": true,
      "value": ""
    },
    "SPAMWATCH_API": {
      "description": "API key from https://t.me/SpamWatchBot",
      "required": true,
      "value": ""
    }
  }
}
